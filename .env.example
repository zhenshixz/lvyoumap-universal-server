HOST=127.0.0.1
PORT=3000
WEATHER_PROVIDER=auto
WEATHER_CACHE_MINUTES=10
WEATHER_STALE_HOURS=6
WEATHER_TIMEOUT_MS=4000

# Recommended production provider: QWeather.
# Use the dedicated API Host shown in the QWeather console.
QWEATHER_API_HOST=

# Preferred long-term authentication.
QWEATHER_KEY_ID=
QWEATHER_PROJECT_ID=
QWEATHER_PRIVATE_KEY_PATH=

# Simpler temporary authentication. Do not commit a real key.
QWEATHER_API_KEY=
