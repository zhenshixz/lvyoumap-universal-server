      "image_source": {
        "title": "炳灵寺石窟千年奇观 🌟藏在甘肃临夏永靖县积石山大寺沟西侧崖壁的",
        "author": "公开网页图片提供者",
        "provider": "公开图片搜索",
        "license": "公开网页图片（家庭自用展示）",
