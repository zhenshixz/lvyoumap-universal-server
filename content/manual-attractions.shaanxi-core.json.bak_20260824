      "guide_data": {
        "clothing": {
          "spring_autumn": "轻便衣物、薄外套和舒适步行鞋适合街区与室内外连续游览。",
          "summer": "透气速干衣、防晒和补水用品并备，午后安排室内点位更舒适。",
          "winter": "准备薄至中等厚度外套，阴雨天增加防水鞋和便携雨具。",
          "tips": "城市街区步行和排队时间可能较长，优先穿软底防滑鞋。"
        },
        "transport": {
          "external_arrive": "自驾导航至金丝峡游客中心或陆督门停车场，走沪陕高速G40在金丝峡出口下道；公共交通可从西安客运站乘大巴至商南县，再转乘班车至金丝峡镇。",
          "internal_arrive": "建议从游客中心乘坐景交车直达山顶栗园门入园，从上往下走最省力。",
          "internal_traffic": "景区内需购买景交车，往返游客中心与栗园门、陆督门，单程车程约30-40分钟。",
          "tips": "返程班次、末班车和临时交通管制可能变化，出发前在官方渠道复核。"
        },
        "housing": [
