      "guide_data": {
        "clothing": {
          "spring_autumn": "以轻便整洁衣物和舒适步行鞋为主，室内外温差大时备一件薄外套。",
          "summer": "穿透气衣物并备薄外套，展馆或演出场馆空调环境可能偏凉。",
          "winter": "常规保暖衣物即可，步行串联周边街区时注意天气变化。",
          "tips": "历史建筑、纪念场馆和宗教场所宜衣着得体，避免影响参观秩序。"
        },
        "transport": {
          "external_arrive": "公交8路、62路、66路、619路至\"驸马巷站\"下车步行可达；自驾可停博物馆停车场或淮安府署门口停车场。",
          "internal_arrive": "从南门进入，乘电梯直达地下一层主展区，游览完毕从北门出，动线不折返。",
          "internal_traffic": "馆内以电梯和扶梯为主，负一层5100㎡展区为单层平面布局，无需上下楼，对长辈和推婴儿车的家庭非常友好。",
          "tips": "返程班次、末班车和临时交通管制可能变化，出发前在官方渠道复核。"
        },
