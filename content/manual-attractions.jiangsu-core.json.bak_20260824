      "guide_data": {
        "clothing": {
          "spring_autumn": "轻便衣物、薄外套和舒适步行鞋适合街区与室内外连续游览。",
          "summer": "透气速干衣、防晒和补水用品并备，午后安排室内点位更舒适。",
          "winter": "准备薄至中等厚度外套，阴雨天增加防水鞋和便携雨具。",
          "tips": "城市街区步行和排队时间可能较长，优先穿软底防滑鞋。"
        },
        "transport": {
          "external_arrive": "高铁优先买镇江站（地处老城区，距景区近），打车到各景区约10分钟；自驾导航至各景区停车场，但金山和西津渡附近停车较紧张，不建议自驾。",
          "internal_arrive": "金山从金山大门进；北固山从南门进；焦山从南门码头坐轮渡登岛（门票含船票），不要信黄牛收额外船费。",
          "internal_traffic": "三山之间打车起步价可达，也可乘公交49路、104路等串联；焦山岛上可步行或乘观光电瓶车（费用以官方当日公告为准）。",
          "tips": "返程班次、末班车和临时交通管制可能变化，出发前在官方渠道复核。"
        },
        "housing": [
          {
            "area": "推荐住大市口商圈或镇江站附近，吃饭购物齐全，打车到各景点基本10分钟内；慎选西津渡古街内部民宿，夜间有噪音且拖行李走石板路不便。",
            "desc": "选择轨道交通便利、与下一日行程衔接顺畅的区域，不必只追求景区门口。"
          }
