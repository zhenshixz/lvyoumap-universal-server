      "image_source": {
        "title": "果洛州阿尼玛卿雪山,藏族神山圣洁迎新春",
        "author": "公开网页图片提供者",
        "provider": "公开图片搜索",
        "license": "公开网页图片（家庭自用展示）",
        "licenseUrl": "http://baijiahao.baidu.com/s?id=1857767512711830035&wfr=spider&for=pc",
        "sourceUrl": "http://baijiahao.baidu.com/s?id=1857767512711830035&wfr=spider&for=pc",
        "width": 1200,
        "height": 720
      },
      "quality_status": {
        "reviewRequired": true,
        "warnings": [
          "仅核验到城市级属地，具体入口需以景区官方导航为准"
        ]
