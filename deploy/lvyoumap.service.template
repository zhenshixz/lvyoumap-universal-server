[Unit]
Description=Lvyoumap Universal Server API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lvyoumap
Group=lvyoumap
WorkingDirectory=/opt/lvyoumap/current
Environment=NODE_ENV=production
EnvironmentFile=-/etc/lvyoumap.env
ExecStart=__NODE_PATH__ /opt/lvyoumap/current/server/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lvyoumap

[Install]
WantedBy=multi-user.target
